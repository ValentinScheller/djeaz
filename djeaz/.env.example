# Chaîne PostgreSQL de l'application (runtime). En local : base Docker djeaz_dev.
# postgresql://djeaz:djeaz@127.0.0.1:5432/djeaz_dev
DATABASE_URL=
# Chaîne directe pour les migrations. En local, même base que DATABASE_URL.
# Avec Neon, utiliser l'URL directe non poolée. Ne pas y mettre la base de tests djeaz_test.
DATABASE_MIGRATION_URL=
# Secret Better Auth, au moins 32 caractères (openssl rand -base64 32).
# Réservé au serveur : ne jamais le préfixer par NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
# URL absolue de l'application (http ou https)
BETTER_AUTH_URL=
